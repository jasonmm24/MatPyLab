# Python
# Ignora archivos temporales de bytecode y caché generados por Python.
__pycache__/
*.py[cod]
*$py.class
# Bibliotecas nativas compiladas, como fast_math.so, que no deben versionarse.
*.so

# Entornos virtuales
# Evita incluir entornos virtuales locales en el repositorio.
venv/
env/
.env
.venv

# PySide/Qt
# Archivos de autosave generados por Qt Designer o la interfaz de usuario.
*.ui.autosave

# VS Code
# Configuración local del editor que no debe publicarse en el repositorio.
.vscode/